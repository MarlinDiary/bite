    "One for each dot, for whatever's on your mind. Click a dot, or press ⌘1 to ⌘7, to switch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドットごとに1ページ、気になることを何でも。ドットをクリックするか、⌘1〜⌘7を押して切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점마다 한 페이지씩, 마음에 걸리는 일을 적어 두세요. 점을 클릭하거나 ⌘1~⌘7을 눌러 전환하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个圆点一页，记下心里惦记的事。点按圆点，或按下 ⌘1 到 ⌘7 即可切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個圓點一頁，記下心裡惦記的事。按一下圓點，或按下 ⌘1 到 ⌘7 即可切換。"
          }
        }
      }
    },
