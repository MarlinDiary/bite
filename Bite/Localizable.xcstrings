    "One for each dot, for whatever's on your mind. Swipe or tap to switch." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドットごとに1ページ、気になることを何でも。スワイプかタップで切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "점마다 한 페이지씩, 마음에 걸리는 일을 적어 두세요. 쓸어넘기거나 탭해서 전환하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个圆点一页，记下心里惦记的事。轻扫或轻点即可切换。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個圓點一頁，記下心裡惦記的事。滑動或點一下即可切換。"
          }
        }
      }
    },
